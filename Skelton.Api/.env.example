# LLM Provider Configuration
# Choose from: openai, anthropic
LLM_PROVIDER=openai

# API Key for your chosen LLM provider
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Anthropic: Get from https://console.anthropic.com/settings/keys
LLM_API_KEY=your-api-key-here

# Model Selection (Optional - uses provider defaults if not set)
# OpenAI models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Anthropic models: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229
LLM_MODEL=gpt-4o-mini

# Custom LLM Endpoint (Optional - for custom deployments)
# LLM_ENDPOINT=https://your-custom-endpoint.com/v1/chat/completions

# Server Port (Optional - defaults to 8080)
# PORT=8080
